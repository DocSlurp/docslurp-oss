{
  "name": "docslurp-oss",
  "private": true,
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=24"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocSlurp/docslurp-oss.git"
  },
  "bugs": {
    "url": "https://github.com/DocSlurp/docslurp-oss/issues"
  },
  "homepage": "https://docslurp.io",
  "scripts": {
    "psl:update": "pnpm --filter @docslurp/server psl:update",
    "test": "pnpm test:packages && pnpm --filter @docslurp/worker test && pnpm --filter @docslurp/server test",
    "test:packages": "pnpm -r --filter @docslurp/cli --filter @docslurp/contrib-astro --filter @docslurp/contrib-search-compat --filter @docslurp/sdk --filter @docslurp/shared test && pnpm test:scripts",
    "test:mcp": "pnpm --filter @docslurp/shared build && pnpm --filter @docslurp/server exec vitest run src/lib/mcp-http.test.ts src/lib/mcp-pi.test.ts src/__tests__/mcp-oauth.test.ts src/__tests__/mcp-routes.test.ts src/__tests__/mcp-oauth-client.db.test.ts src/__tests__/mcp-pi-agent.db.test.ts src/__tests__/chat-completions.test.ts src/__tests__/chat-completions-openai-sdk.test.ts",
    "test:scripts": "node scripts/node-test.mjs scripts/*.test.mjs scripts/lib/*.test.mjs scripts/multisearch-quality/*.test.mjs packages/contrib-astro/*.test.mjs",
    "dev:api": "pnpm --filter @docslurp/server dev",
    "start:api": "pnpm --filter @docslurp/server start",
    "dev": "pnpm dev:api",
    "dev:worker": "pnpm --filter @docslurp/worker dev",
    "worker:python:setup": "bash scripts/setup-worker-python-venv.sh",
    "eval:routing": "pnpm --filter @docslurp/worker eval:document-routing",
    "worker:check": "node scripts/check-worker-prerequisites.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @docslurp/shared build && pnpm --filter @docslurp/sdk build && pnpm --filter @docslurp/contrib-search-compat build && pnpm -r typecheck",
    "docs:check": "node scripts/check-docs-links.mjs && node scripts/check-docs-mermaid.mjs",
    "env:check": "node scripts/check-env.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:introspect": "drizzle-kit introspect --config=drizzle.config.ts",
    "db:migrate": "node server/db/migrate.mjs",
    "db:seed": "pnpm --filter @docslurp/server db:seed",
    "db:up": "docker compose up -d postgres redis minio createbucket temporal temporal-ui",
    "fixtures:fetch": "node scripts/fetch-fixtures.mjs",
    "release:prepare": "node scripts/package-release.mjs prepare",
    "release:check": "node scripts/package-release.mjs check",
    "release:tag": "node scripts/package-release.mjs tag"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^2.1.5",
      "fast-xml-parser": "^5.5.11",
      "hono": "^4.13.14",
      "vite": "^8.3.5",
      "@esbuild-kit/core-utils>esbuild": "^0.28.2",
      "@prisma/config>effect": "^3.22.2",
      "@prisma/config>deepmerge-ts": "^8.0.0",
      "lodash": "^4.18.1",
      "mysql2": "^3.24.4",
      "sharp": "0.35.5",
      "@prisma/dev>valibot": "^1.5.0",
      "@modelcontextprotocol/sdk": "^1.31.0",
      "source-map-js": "^1.2.2",
      "smol-toml": "^1.9.0",
      "katex": "^0.19.1",
      "@opentelemetry/api": "1.9.1",
      "mammoth>argparse": "^2.0.1",
      "@opentelemetry/otlp-exporter-base": "0.223.0",
      "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
      "@earendil-works/pi-coding-agent>undici": "8.12.3",
      "express>body-parser": "^2.4.0",
      "ajv>fast-uri": "^3.1.9"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "msw",
      "onnxruntime-node",
      "prisma",
      "protobufjs",
      "sharp"
    ],
    "patchedDependencies": {
      "postgres@3.4.9": "patches/postgres@3.4.9.patch"
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "postgres": "^3.4.9"
  }
}

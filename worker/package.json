{
  "name": "@docslurp/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/temporal/worker.js",
  "types": "dist/temporal/worker.d.ts",
  "exports": {
    ".": {
      "types": "./dist/temporal/worker.d.ts",
      "default": "./dist/temporal/worker.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/temporal/worker.ts",
    "start": "node dist/temporal/worker.js",
    "build": "pnpm --filter @docslurp/shared build && tsc -p tsconfig.json && node scripts/copy-routing-assets.mjs",
    "typecheck": "pnpm --filter @docslurp/shared build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:temporal-replay": "vitest run src/__tests__/temporal-replay.test.ts",
    "temporal:record-histories": "tsx src/test/temporal-replay/record-histories.ts",
    "fixtures:pdf": "node testdata/pdf-fixtures/generate-fixtures.mjs",
    "benchmark:vision": "tsx src/benchmarks/vision-benchmark-cli.ts",
    "benchmark:kreuzberg": "tsx src/benchmarks/kreuzberg-benchmark-cli.ts",
    "benchmark:parsebench": "tsx src/benchmarks/parsebench-benchmark-cli.ts",
    "benchmark:pdf-fixtures": "tsx src/benchmarks/pdf-fixture-benchmark-cli.ts",
    "bench:sandbox": "tsx src/benchmarks/sandbox-overhead-cli.ts",
    "benchmark:extractors": "tsx src/benchmarks/extractor-benchmark-cli.ts",
    "benchmark:parser-policy-eval": "tsx src/benchmarks/parser-policy-eval-cli.ts",
    "eval:document-routing": "pnpm --filter @docslurp/shared build && tsx src/benchmarks/document-routing-eval-cli.ts",
    "eval:local-vision": "tsx src/benchmarks/local-vision-model-eval-cli.ts",
    "media:watchdog": "node dist/media/capacity/watchdog.js",
    "media:reconcile": "node dist/media/reconcile-cli.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/openai": "4.0.104",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@docslurp/shared": "workspace:*",
    "@huggingface/transformers": "^4.3.2",
    "@kreuzberg/node": "^4.10.2",
    "@lancedb/lancedb": "^0.40.0",
    "@llamaindex/liteparse": "2.17.0",
    "@streamparser/json": "0.0.26",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "ai": "7.0.156",
    "dotenv": "^18.0.9",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "^6.4.299",
    "postgres": "^3.4.9",
    "redis": "^6.3.1",
    "sharp": "0.35.5"
  },
  "optionalDependencies": {
    "@kreuzberg/node-linux-arm64-gnu": "4.10.2",
    "@kreuzberg/node-linux-x64-gnu": "4.10.2",
    "modal": "0.11.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@temporalio/testing": "1.25.0",
    "@types/node": "^26.6.6",
    "vitest": "^5.0.5"
  },
  "license": "SEE LICENSE IN LICENSE"
}

    {
      "id": "born-digital-metadata-prose",
      "path": "kreuzberg-metadata-document.pdf",
      "tags": ["born-digital", "metadata", "negative-control"],
      "expectedFailure": {
        "reason": "Known gap since the LiteParse removal (73456463). On poppler-text output the page's six 'Key: value' property lines plus the word 'date' meet the v1 form rule (colon lines >= 25% of lines and a field keyword), so the page routes as a form with aggressive vision. Narrowing that rule to make this page pass would tune production routing to this fixture; it needs a form-detection change validated on other documents."
      },
      "expected": {
        "suggestedPlaybook": "fast",
        "visionPolicy": "skip",
        "pages": [
          {
            "pageNumber": 1,
            "route": "straightforward-text",
            "extractorHint": "cheap-text",
            "ocrAuthorized": false
          }
        ]
      }

{
  "schemaVersion": "document-routing-eval@v1",
  "description": "Deterministic local routing contracts for synthetic scans, handwriting, forms, tables, formulas, and born-digital prose. Expectations are eval-only and must never be copied into production routing rules.",
  "gates": {
    "minimumQualityScore": 1,
    "minimumFixturePassRate": 1,
    "maximumP95LatencyMs": 5000,
    "maximumHostedAiCalls": 0,
    "maximumEstimatedCostUsd": 0
  },
  "fixtures": [
    {
      "id": "handwriting-with-native-context",
      "path": "kreuzberg-handwriting-notes.pdf",
      "tags": ["handwriting", "scanned", "mixed-raster-text"],
      "expectedFailure": {
        "reason": "Policy, not evidence. Page 1 has about 60 native words (Doppler and Poppler read the same text) beside a 560x420 scanned image. OCR was authorized only by LiteParse's structured-complexity path (authorizeStructuredOcr), which no shipped extractor feeds. The shared raster rule (decidePageRaster, mirrored by the offline estimator) reads a page with 30 or more native words as a Fast text page and never OCRs it. Passing needs an owner decision to OCR text pages that also carry a large image (Rich billing on such pages), not a routing fix."
      },
      "expected": {
        "suggestedPlaybook": "review-grade",
        "visionPolicy": "aggressive",
        "pages": [
          {
            "pageNumber": 1,
            "route": "handwriting-or-degraded",
            "extractorHint": "vision-rescue",
            "ocrAuthorized": true
          }
        ]
      }
    },
    {
      "id": "image-only-multipage-scan",
      "path": "image-heavy-ocr.pdf",
      "tags": ["handwriting", "scanned", "image-only", "multipage"],
      "expected": {
        "suggestedPlaybook": "review-grade",
        "visionPolicy": "aggressive",
        "pages": [
          {
            "pageNumber": 1,
            "route": "handwriting-or-degraded",
            "extractorHint": "vision-rescue",
            "ocrAuthorized": true
          },
          {
            "pageNumber": 2,
            "route": "handwriting-or-degraded",
            "extractorHint": "vision-rescue",
            "ocrAuthorized": true
          }
        ]
      }
    },
    {
      "id": "structured-form-with-annotations",
      "path": "form-rotated-notes.pdf",
      "tags": ["forms", "annotations", "rotated-text"],
      "expected": {
        "suggestedPlaybook": "layout-aware",
        "pages": [
          {
            "pageNumber": 1,
            "route": "form",
            "extractorHint": "layout-aware",
            "ocrAuthorized": false
          }
        ]
      }
    },
    {
      "id": "contiguous-multipage-table",
      "path": "tables-multipage-financials.pdf",
      "tags": ["tables", "multipage", "structured-data"],
      "expected": {
        "suggestedPlaybook": "layout-aware",
        "pages": [
          {
            "pageNumber": 1,
            "route": "table-heavy",
            "extractorHint": "layout-aware",
            "ocrAuthorized": false
          },
          {
            "pageNumber": 2,
            "route": "table-heavy",
            "extractorHint": "layout-aware",
            "ocrAuthorized": false
          },
          {
            "pageNumber": 3,
            "route": "table-heavy",
            "extractorHint": "layout-aware",
            "ocrAuthorized": false
          }
        ]
      }
    },
    {
      "id": "formula-heavy-academic-document",
      "path": "academic-latex-ligatures.pdf",
      "tags": ["formulas", "latex", "born-digital"],
      "expected": {
        "suggestedPlaybook": "agentic",
        "pages": [
          {
            "pageNumber": 1,
            "route": "formula-heavy",
            "extractorHint": "syntax-preserving",
            "ocrAuthorized": false
          },
          {
            "pageNumber": 2,
            "route": "formula-heavy",
            "extractorHint": "syntax-preserving",
            "ocrAuthorized": false
          }
        ]
      }
    },
    {
      "id": "born-digital-metadata-prose",
      "path": "kreuzberg-metadata-document.pdf",
      "tags": ["born-digital", "metadata", "negative-control"],
      "expectedFailure": {
        "reason": "Expectation predates an extractor that sees this page's table. Doppler extracts its 4-row revision-history table as a real table (LiteParse and Kreuzberg did not), so the page routes table-heavy: layout-aware, and, as the only page, aggressive vision. Whether one small table on a prose page should route as table-heavy is routing policy for the owner and council; tuning the table rule to this page would fit production routing to the fixture."
      },
      "expected": {
        "suggestedPlaybook": "fast",
        "visionPolicy": "skip",
        "pages": [
          {
            "pageNumber": 1,
            "route": "straightforward-text",
            "extractorHint": "cheap-text",
            "ocrAuthorized": false
          }
        ]
      }
    }
  ]
}

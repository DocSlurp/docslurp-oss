{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docslurp.io/schemas/layout-annotation-confidence-v1.json",
  "title": "Hash-bound annotation evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scale",
    "pageId",
    "artifacts",
    "evidence",
    "regions",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "layout-annotation-confidence-v1"
    },
    "scale": {
      "const": "evidence-ordinal-not-probability"
    },
    "pageId": {
      "type": "string"
    },
    "artifacts": {
      "type": "object",
      "required": [
        "imageSha256",
        "sourceSha256",
        "referenceSha256"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "actor",
          "actorType",
          "method",
          "scope"
        ],
        "properties": {
          "actor": {
            "type": "string"
          },
          "actorType": {
            "enum": [
              "agent",
              "human",
              "tool"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "independentOfAuthor": {
            "type": "boolean"
          },
          "artifact": {
            "type": "string"
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "regionId",
          "axes"
        ],
        "properties": {
          "regionId": {
            "type": "string"
          },
          "axes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geometry",
              "semanticLabel",
              "textTranscription",
              "visibilityOcclusion",
              "readingOrder"
            ],
            "properties": {
              "geometry": {
                "$ref": "#/$defs/axis"
              },
              "semanticLabel": {
                "$ref": "#/$defs/axis"
              },
              "textTranscription": {
                "$ref": "#/$defs/axis"
              },
              "visibilityOcclusion": {
                "$ref": "#/$defs/axis"
              },
              "readingOrder": {
                "$ref": "#/$defs/axis"
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "status",
        "basis",
        "provenance"
      ],
      "properties": {
        "score": {
          "enum": [
            null,
            0,
            0.25,
            0.5,
            0.75,
            1
          ]
        },
        "status": {
          "enum": [
            "unknown",
            "unverified",
            "source-derived",
            "estimated",
            "visually-reviewed",
            "independently-validated",
            "not-applicable"
          ]
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "score": {
                "const": null
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "status": {
                "const": "not-applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score": {
                "enum": [
                  0.75,
                  1
                ]
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score": {
                "const": 0.25
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "unverified"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score": {
                "const": 0.5
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "source-derived",
                  "estimated"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score": {
                "const": 0.75
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "visually-reviewed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "independently-validated"
                ]
              }
            }
          }
        }
      ]
    }
  }
}

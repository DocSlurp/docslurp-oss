# Generated by `node scripts/selfhost-init.mjs`. Keep .env.selfhost private and backed up.
# Set SELFHOST_URL to the browser-visible origin before starting (no trailing slash).
SELFHOST_URL=http://localhost:8787
# Set to true only when SELFHOST_URL is a plain http://localhost origin (local trial runs).
DOCSLURP_ALLOW_INSECURE_LOCAL_AUTH_ORIGIN=true
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=8787
BETTER_AUTH_TRUST_PROXY_HEADERS=false
POSTGRES_PASSWORD=REPLACE_ME
DATABASE_URL=postgres://docslurp:REPLACE_ME@postgres:5432/docslurp
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
BETTER_AUTH_SECRET=REPLACE_ME
OAUTH_TOKEN_ENCRYPTION_KEY=REPLACE_ME
CREDENTIALS_ENCRYPTION_KEY=REPLACE_ME
SECRETS_ENCRYPTION_KEY=REPLACE_ME
METRICS_SECRET=REPLACE_ME

# Optional sizing and integrations. Leave provider keys blank for local embeddings.
WORKER_DOC_CONCURRENCY=1
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

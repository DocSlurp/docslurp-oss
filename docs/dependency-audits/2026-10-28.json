  "securityChanges": [
    "Override @earendil-works/pi-coding-agent>undici to 8.12.3: pi-coding-agent 1.4.0 still pins undici 8.10.2 exactly, which carries 9 advisories (TLS certificate validation bypass, cross-user cache poisoning, several DoS); server already declares 8.12.3 directly",
    "Override express>body-parser to ^2.4.0 (DoS via trailing bytes, reached through @modelcontextprotocol/sdk express transport)",
    "Override ajv>fast-uri to ^3.1.9 (URI scheme spoofing, host confusion)",
    "Node 24.21.0 -> 24.22.1 (2026-10-20 security release) in server and worker images by refreshing node:24-*-slim digests",
    "@node-saml/node-saml 5.1.0 -> 5.2.0: checks idpIssuer on the Response and assertion, rejects multiple Issuers, fixes maxAssertionAgeMs skipping; DocSlurp already passes idpIssuer from IdP metadata and uses only the POST binding",
    "docker/login-action v4.6.0 -> v4.7.0 and github/codeql-action/upload-sarif v4.39.0 -> v4.39.1, pinned by commit SHA"
  ],
  "compatibilityHolds": {
    "typescript": "6.0.3: Astro check supports TypeScript 5/6, not 7",
    "openai": "6.49.0: 7.x is a major API change; held with the AI SDK family",
    "opentelemetry": "2.12/0.223/API 1.9.1: 3.0/0.300 is a breaking family change; Langfuse 6 requires SDK 2",
    "filelock": "3.32.7 in dev-only ML locks: forcing >=4.2.1 downgrades unstructured 0.27.33 -> 0.20.8 (unstructured caps filelock<4)"
  },
  "limitations": [
    "ChromaDB 1.5.9 advisories have no published fix; DocSlurp uses HttpClient/PersistentClient for the optional vector backend, not the Chroma HTTP server, and production images do not install it",
    "Worker images were not rebuilt or smoke-tested here; the digest refresh takes effect on the next worker-images run",
    "No production deployment, model download or hosted quality evaluation was run"
  ]

---
/**
 * Browser key only: restrict it to this site's origin and the search scope.
 * workspace takes an ID, slug or name, or "default" (the key organization's default
 * workspace) and defaults to "default"; apiUrl defaults to https://docslurp.io.
 */
interface Props { clientKey: string; workspace?: string; apiUrl?: string; placeholder?: string; }
const { clientKey, workspace = 'default', apiUrl = 'https://docslurp.io', placeholder = 'Search documents…' } = Astro.props;
---
<docslurp-search-box api-url={apiUrl} workspace={workspace} client-key={clientKey} placeholder={placeholder}></docslurp-search-box>
<noscript><p>Enable JavaScript to search the document collection.</p></noscript>
<script>
  import { defineDocSlurpSearch } from '@docslurp/sdk/widget';
  defineDocSlurpSearch();
</script>

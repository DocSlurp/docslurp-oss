---
import { assertBrowserSafeApiKey, assertSecureApiOrigin } from "@docslurp/sdk";
/**
 * Browser key only: restrict it to this site's origin and the search scope.
 * project takes an ID, slug or name, or "default" (the key organization's default
 * project) and defaults to "default"; apiUrl defaults to https://docslurp.io.
 */
interface Props { clientKey: string; project?: string; apiUrl?: string; placeholder?: string; }
const { clientKey, project = 'default', apiUrl = 'https://docslurp.io', placeholder = 'Search documents…' } = Astro.props;
assertBrowserSafeApiKey(clientKey, true);
assertSecureApiOrigin(apiUrl);
---
<docslurp-search-box api-url={apiUrl} project={project} client-key={clientKey} placeholder={placeholder}></docslurp-search-box>
<noscript><p>Enable JavaScript to search the document collection.</p></noscript>
<script>
  import { defineDocSlurpSearch } from '@docslurp/sdk/widget';
  defineDocSlurpSearch();
</script>

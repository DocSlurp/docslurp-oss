{
  "name": "@docslurp/sdk",
  "version": "0.3.0",
  "description": "TypeScript client for DocSlurp document ingestion and cited search, with embeddable React and Web Component surfaces at @docslurp/sdk/embed.",
  "license": "MIT",
  "homepage": "https://docslurp.io/docs/packages/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocSlurp/docslurp-oss.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/DocSlurp/docslurp-oss/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./search-adapters": {
      "types": "./dist/search-adapters.d.ts",
      "import": "./dist/search-adapters.js"
    },
    "./widget": {
      "types": "./dist/search-widget.d.ts",
      "import": "./dist/search-widget.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed/index.js"
    },
    "./astro": "./integrations/astro/DocSlurpSearch.astro",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "examples",
    "integrations",
    "NOTICE",
    "LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node ../../scripts/node-test.mjs test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@lancedb/lancedb": "^0.39.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "@lancedb/lancedb": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@lancedb/lancedb": "^0.40.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@docslurp/server",
  "version": "0.1.0",
  "description": "DocSlurp Hono API server: routes, services and startup tasks.",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "pnpm --filter @docslurp/shared build && pnpm --filter @docslurp/sdk build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run && pnpm test:db",
    "test:db": "pnpm --filter @docslurp/shared build && tsx db/tests/run.mjs",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "tsx db/seed.ts",
    "catalog:feed": "tsx scripts/stripe-catalog-feed.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.99",
    "@ai-sdk/otel": "^1.0.148",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@docslurp/sdk": "workspace:*",
    "@docslurp/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@huggingface/transformers": "^4.3.1",
    "@lancedb/lancedb": "^0.40.0",
    "@mastra/ai-sdk": "^1.11.2",
    "@mastra/core": "^1.79.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@node-saml/node-saml": "^5.1.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@posthog/ai": "^8.14.3",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "ai": "7.0.148",
    "better-auth": "^1.7.12",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "redis": "^6.3.0",
    "stripe": "^23.0.0",
    "tsx": "^4.23.15",
    "undici": "8.12.3",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.152",
    "@docslurp/worker": "workspace:*",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/xml2js": "^0.4.14",
    "openai": "6.49.0",
    "typebox": "1.4.2",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "license": "SEE LICENSE IN LICENSE"
}

# DocSlurp environment template
# Copy to `.env` for local development. Keep secrets in ignored env files or your deployment secret store.

# -----------------------------------------------------------------------------
# Core application and database
# -----------------------------------------------------------------------------
# Local development defaults point at Docker Compose service names.
# The Astro app serves both the dashboard and mounted Hono API on :4321.
# The app/API/worker rewrite these to localhost automatically when you run them outside containers.
DATABASE_URL=postgres://docslurp:docslurp@postgres:5432/docslurp
APP_URL=http://localhost:4321
API_URL=http://localhost:4321
# Optional canonical public origin for MCP OAuth discovery; defaults to API_URL.
# Set to the external HTTPS origin when behind a proxy; never an internal host.
# MCP_PUBLIC_URL=https://docslurp.io
PUBLIC_API_URL=http://localhost:4321
INTERNAL_API_URL=http://localhost:4321
PORT=8787

# -----------------------------------------------------------------------------
# Product analytics
# -----------------------------------------------------------------------------
# Optional alternative OTLP HTTP logs backend, used by both API and workers.
# Standard OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_HEADERS also work.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_HEADERS=

# -----------------------------------------------------------------------------
# Object storage
# -----------------------------------------------------------------------------
# One URI per adapter: s3://[KEY:SECRET@]bucket?endpoint=&region=&pathStyle=&purgeSupersededSources=
# The `minio` host is rewritten to localhost for processes running outside Docker.
STORAGE_URI=s3://docslurp-files?endpoint=http://minio:9000&region=us-west-2
# R2:      STORAGE_URI=s3://your-bucket?endpoint=https://<account-id>.r2.cloudflarestorage.com&region=auto
# AWS S3:  STORAGE_URI=s3://your-bucket?region=us-east-1&pathStyle=false
# Credentials: URL-encoded URI userinfo (s3://KEY:SECRET@bucket?...) or the standard
# AWS variables below. Local Docker Compose also uses these as the MinIO root
# user/password and falls back to minioadmin when blank. Production must set
# strong random object-storage credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional S3 client tuning (server and worker); unset = AWS SDK defaults.
# S3_MAX_SOCKETS=256
# S3_KEEPALIVE=true
# S3_KEEPALIVE_INITIAL_DELAY_MS=1000
# S3_CONNECTION_TIMEOUT_MS=3000
# S3_REQUEST_TIMEOUT_MS=60000
# S3_SOCKET_TIMEOUT_MS=60000
# S3_MAX_ATTEMPTS=3
# S3_RETRY_MODE=standard            # standard | adaptive
# S3_CHECKSUM_MODE=when_required    # when_supported | when_required (B2/R2 often need when_required)
# S3_FORCE_PATH_STYLE=true          # overrides STORAGE_URI pathStyle
# S3_MULTIPART_PART_SIZE_MB=8       # streamed uploads, 5-5120 (default 8)

# Optional separate store for LanceDB (needs conditional PutObject; B2 lacks it).
# Same shape as STORAGE_URI; LANCEDB_URI defaults to s3://<its bucket>/lancedb.
# LANCEDB_STORAGE_URI=s3://KEY:SECRET@index-bucket?endpoint=https://fly.storage.tigris.dev&region=auto
# LANCEDB_CONNECT_TIMEOUT_SECONDS=5
# LANCEDB_REQUEST_TIMEOUT_SECONDS=60
# LANCEDB_CLIENT_MAX_RETRIES=10
# LANCEDB_POOL_MAX_IDLE_PER_HOST=32
# Trace Lance's native S3 requests through a localhost re-signing proxy (spans plus a [lancedb-s3]
# summary every 60s). Adds a hop per request; needs explicit credentials. See docs/dependency-tracing.md.
# LANCEDB_S3_TRACE=1

# -----------------------------------------------------------------------------
# Worker vendor bundles (docling/unstructured) from a private S3-compatible bucket
# (docs/worker-image.md#vendor-bundles). Use a read-only key; unset = bundles off.
# DOCSLURP_VENDOR_BUNDLE_BASE_URL=s3://docslurp-vendor-bundles
# DOCSLURP_VENDOR_BUNDLE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# DOCSLURP_VENDOR_BUNDLE_S3_REGION=us-west-004
# DOCSLURP_VENDOR_BUNDLE_S3_ACCESS_KEY_ID=
# DOCSLURP_VENDOR_BUNDLE_S3_SECRET_ACCESS_KEY=
# DOCSLURP_VENDOR_BUNDLE_PREFETCH=unstructured

# AI providers, vision, embeddings, and vector storage
# -----------------------------------------------------------------------------
# Non-commercial model weights (e.g. jinaai/jina-ocr-v1, jina-embeddings-v5-omni-*,
# CC-BY-NC-4.0) are refused unless this is true. Enable only for research/eval use
# where that licence applies; never in commercial deployments.
NON_COMMERCIAL_MODE=false
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
# Optional hosted embeddings (llm://deepinfra/BAAI/bge-m3, native 1024 dimensions)
# and opt-in hosted reranking.
DEEPINFRA_API_KEY=
# Native embedding endpoint; PERPLEXITYAI_API_KEY is also accepted as a legacy alias.
PERPLEXITY_API_KEY=
PERPLEXITYAI_API_KEY=
XAI_API_KEY=
# Legacy provider aliases accepted by the runtime; prefer the canonical names above.
# GOOGLE_KEY=
# OPENROUTER_KEY=
OPENROUTER_API_KEY=
# Also powers chat microphone input through Mastra Voice / microsoft/mai-transcribe-2.
# Worker text generation fallback; workspace textGeneration settings override it.
# DOCSLURP_TEXT_MODEL=qwen/qwen3.5-flash-02-23
# Optional source-grounded, concise, low-reasoning text profile (workspace overrides win).
# DOCSLURP_TEXT_PROFILE=grounded-low
# API search/helper fallback; must be an allowed workspace chat model.
# DOCSLURP_SEARCH_MODEL=z-ai/glm-5.3-flash
# Keyword search serves a document's chunks as soon as the embed stage writes
# them, before vectors are indexed and the document completes; search and chat
# report partial coverage meanwhile (availability.keywordOnly). On by default
# outside production; set 0 to wait for completion. Worker-gated: applies only once
# every live worker advertises search.early-lexical (docs/releases.md#app-and-worker-skew).
# SEARCH_EARLY_LEXICAL=1
# Worker-only, default off. Set to exactly `on` to write a document's chunk rows
# (and stamp the keyword-searchable marker) before the embedding provider calls,
# so keyword search can serve them while embedding runs. Any other value, or unset,
# publishes after embedding as before (still ahead of vector indexing). Chunk rows
# and the embedding artifact are identical either way; only the order changes.
# Search only serves them when SEARCH_EARLY_LEXICAL (server) is on as well.
# DOCSLURP_EARLY_LEXICAL_CHUNKS=on
# Search relevance floor, 0..1 (default 0.1; 0 disables). Results whose raw match
# strength is below it are dropped, and search/chat report noMatch instead of
# returning weak passages. Strength is the best of: embedding cosine rescaled above
# the model's unrelated-text baseline, or the share of query terms found in the
# chunk. A request's minScore or a workspace retrieval default overrides this.
# Calibrated for bge-m3 only; re-measure with scripts/calibrate-relevance-floor.mjs for other models.
# SEARCH_MIN_SCORE=0.1
# Public chat APIs may run the bounded search agent (repeated searches, cited
# premises). false keeps them on single-pass grounded retrieval.
# DOCSLURP_PUBLIC_CHAT_AGENT_ENABLED=true
# Extra OpenRouter chat models for evaluations, comma-separated (":free" ok).
# Only platform admins (ADMIN_EMAILS sessions, or server API keys they own) may
# request them as /v1/chat `model`. Pro/Ultra ids, ids without a verified price
# in packages/shared/src/chat-model-prices.ts and ids priced at $50+/M output
# tokens are logged and dropped at load. Unset: the normal catalog only.
# DOCSLURP_CHAT_EVAL_MODELS=inception/mercury-3,deepseek/deepseek-v4.1-flash-1017
# Organizations whose workspaces may also use those models and raise /v1/chat
# `agent` limits to the admin range (sessions and server keys; never client
# keys). Decided by the chat workspace's owning org, not by membership. Grants
# no other admin power. Comma-separated org ids; unset: platform admins only.
# DOCSLURP_CHAT_EVAL_ORG_IDS=
# Optional hosted reranking: bounded request concurrency (1–4) and a shared
# provider deadline (1000–30000 ms). Requires explicit workspace opt-in.
# SEARCH_RERANK_CONCURRENCY=4
# SEARCH_RERANK_TIMEOUT_MS=15000
# Query-embedding cache (in-memory LRU, per organization, standard privacy mode only).
# A hit skips the embedding provider call and records no usage event. 0 entries disables.
# SEARCH_EMBEDDING_CACHE_MAX_ENTRIES=1000
# SEARCH_EMBEDDING_CACHE_TTL_SECONDS=3600
# Vector-result cache (off by default). Keyed by org, table version, query vector,
# scope and tuning, so a write to the table is a miss. Set entries > 0 to enable.
# SEARCH_RESULT_CACHE_MAX_ENTRIES=0
# SEARCH_RESULT_CACHE_TTL_SECONDS=30
# Hosted evaluation judge defaults; separate from ingestion/chat model choices.
# DOCSLURP_JUDGE_MODEL=z-ai/glm-5.3-flash
# DOCSLURP_JUDGE_REASONING=low
# Operator-registered private model endpoints (single-tenant OpenAI-compatible
# servers such as vLLM on a rented GPU). JSON array, validated at worker and app
# startup; workspaces reference them as llm://private/<alias>/<model>. Tokens are
# read from the named env var, never inlined. https, or http on a private network
# only. See docs/model-configuration.md#private-model-endpoints.
# DOCSLURP_PRIVATE_MODEL_ENDPOINTS=[{"alias":"gpu1","baseUrl":"https://gpu1.example.internal/v1","auth":{"tokenEnv":"DOCSLURP_PRIVATE_GPU1_TOKEN"},"models":[{"id":"Qwen/Qwen3.6-35B-A3B-FP8","capability":"text","chatTemplateKwargs":{"enable_thinking":false}},{"id":"lightonai/LightOnOCR-3-0.8B","capability":"vision"},{"id":"Qwen/Qwen3-Embedding-0.6B","capability":"embedding","dimensions":1024},{"id":"CohereLabs/cohere-transcribe-03-2026","capability":"stt"}],"attestation":{"tenancy":"single-tenant","hostProvider":"runpod","region":"us-east"},"pricing":{"usdPerHour":1.99,"concurrency":8}}]
# DOCSLURP_PRIVATE_GPU1_TOKEN=
# API chat answers and voice input for local-only/strict-privacy workspaces
# (workspace textGeneration.model wins over the text default).
# DOCSLURP_PRIVATE_TEXT_MODEL=llm://private/gpu1/Qwen/Qwen3.6-35B-A3B-FP8
# DOCSLURP_PRIVATE_STT_MODEL=llm://private/gpu1/CohereLabs/cohere-transcribe-03-2026
# Local tooling defaults (workspace vision models take precedence for extraction).
# DOCSLURP_LOCAL_OCR_MODEL=microsoft/Florence-2-base-ft
# DOCSLURP_CLIP_MODEL=Xenova/clip-vit-base-patch32
VECTOR_BACKENDS=lancedb
REMOTE_INGEST_COMPLEX_FORMATS_ENABLED=false
# Remote URL ingest and connector sync stay on the lean parser surface by default.
# Set true only when you intentionally want remote sources to exercise the full office/html/tiff-style parser stack.
# LanceDB root: a bare path or file:///path for dev, s3://bucket/prefix for production.
# s3:// roots inherit endpoint, region, and credentials from STORAGE_URI; override
# per index with ?endpoint=&region=&allowHttp= (e.g. s3://docslurp-files/lancedb?region=auto).
LANCEDB_URI=/tmp/docslurp-lancedb
# Optional query-time SQ candidate refinement (integer 1–16); unset preserves defaults.
# Larger factors reread more full vectors. HNSW ef is raised to cover limit * factor.
# LANCEDB_REFINE_FACTOR=4
# Search-side LanceDB cache (server process; the worker only sizes its own Session). Unset cache sizes
# default to 25% (index) / 5% (metadata) of the memory the process may use, capped at LanceDB's own
# 6 GB / 1 GB. Prewarm loads the vector/FTS indexes into the cache when a table opens.
# LANCEDB_INDEX_CACHE_MB=
# LANCEDB_METADATA_CACHE_MB=
# LANCEDB_PREWARM_INDEX=false           # true = prewarm indexes on table open (background, errors only logged)
# LANCEDB_PREWARM_BLOCKING=false        # true = the first search waits for the prewarm
# LANCEDB_PREWARM_REFRESH_SECONDS=60    # re-prewarm open tables to pick up indexes the worker rebuilt (0 = never)
# LANCEDB_PREWARM_DATA=false            # also load vector/id/documentId columns; costs RAM of that size
# LANCEDB_READ_CONSISTENCY_SECONDS=30   # how often an open table checks for a new version (0 = every query).
#                                       # Higher = fewer manifest reads, new rows take that long to become searchable.
# Index maintenance (table.optimize(): compaction, index refresh, version cleanup) runs off
# the index stage's critical path in a per-process pool: committed rows are searchable at
# once (unindexed rows are flat-scanned), so documents never wait for it. ?vectorIndexMinRows=5000
# builds the first HNSW_SQ index; ?maintenance=false disables maintenance. Each knob can also
# be set as ?camelCase on LANCEDB_URI; the env var wins. Defaults are benchmarked in
# internal research notes (optimizing every few pages is ~20x slower to query).
# LANCEDB_MAINTENANCE_MODE=background        # inline = exact pre-2026-10-14 behaviour (awaited, old trigger, no rebuild; cadence knobs ignored)
# LANCEDB_OPTIMIZE_EVERY_ROWS=2000           # due after this many rows since the last optimize...
# LANCEDB_OPTIMIZE_EVERY_COMMITS=20          # ...or this many commits (one fragment each)...
# LANCEDB_OPTIMIZE_INTERVAL_SECONDS=300      # ...or this long with any new rows...
# LANCEDB_OPTIMIZE_MIN_INTERVAL_SECONDS=60   # ...but never sooner than this after the last one
# LANCEDB_MAX_INDEX_SEGMENTS=32              # rebuild the vector index into one segment past this (0 = never)
# LANCEDB_CONSOLIDATE_MAX_ROWS=100000        # ...only for tables up to this many rows (0 = no cap)
# LANCEDB_MAINTENANCE_CONCURRENCY=1          # tables maintained at once per worker process (max 8)
# LANCEDB_MAINTENANCE_DRAIN_TIMEOUT_MS=30000 # shutdown wait for running maintenance
# LANCEDB_MAINTENANCE_SWEEP_INTERVAL_MS=60000 # leader sweep for due tables with no new writes (min 5000, 0 = off)

# -----------------------------------------------------------------------------
# Accounts, credits, and quality thresholds
# -----------------------------------------------------------------------------
DEFAULT_USER_ID=demo-user
DEFAULT_MONTHLY_CREDITS=2500
PLAUSIBILITY_WARNING_THRESHOLD=0.3

# -----------------------------------------------------------------------------
# Worker execution, parser policy, and autoscaling
# -----------------------------------------------------------------------------
WORKER_POLL_INTERVAL=5s
WORKER_DOC_CONCURRENCY=3
WORKER_ACTIVITY_CONCURRENCY=1
WORKER_MAX_RUNTIME=
# Drain time for in-flight activities on SIGTERM / max runtime.
WORKER_SHUTDOWN_GRACE=4m
# Per-org worker slots (docs/scaling-1000-workers.md). Plan worker_slots caps
# in-flight page tasks + document stages per org; 0 = no fleet-wide cap.
WORKER_SLOT_ENFORCEMENT=true
WORKER_GLOBAL_SLOT_CAP=0
# Document shards (docs/scaling-1000-workers.md#document-shards): per-document
# stages split into at most min(WORKER_MAX_DOCUMENT_SHARDS, org worker_slots)
# shards, one activity slot each.
WORKER_DOCUMENT_SHARDING=true
# Decision-model page router (docs/page-router.md). Ceiling over each workspace's
# pageRouter.mode: off (default) | shadow (log decisions, extraction unchanged) |
# active (router picks per-page targets). The decision-model router needs
# OPENROUTER_API_KEY (default chain: gpt-6-luna-decisions, clef-flash, jev-1.13;
# liquid/d1 is opt-in; PERPLEXITYAI_API_KEY only for the quarantined Perplexity decider).
# The app reads this too: workspaces that leave pageRouter.mode unset get shadow stamped on new
# runs when it is shadow or active (never active); keep app and worker values equal.
PAGE_ROUTER_MODE=off
# JSON file persisting multi-day decision-model canary history. A quarantined model
# (the Perplexity decider) re-enters the chain only after its noul and choice
# canaries passed on 3 distinct UTC days. Unset = in-memory (resets on restart).
DOCSLURP_DECISION_HEALTH_HISTORY=
# Opt-out of non-free-licensed models and engines (default false: allowed). When true, the page router
# catalogs, decision-model chain, executors and flat-tier OCR route policy never select or call a model
# whose licence class is "non-free" (custom addenda, non-commercial, research-only, undeclared: dots.ocr,
# Nanonets-OCR2, Liquid d1, ...). Proprietary hosted APIs are not covered; privacy modes govern those.
DISABLE_NON_FREE_SOFTWARE=false
# Prefer native-pdf Markdown over the canonical page slice for accepted text pages.
PAGE_ROUTER_PREFER_NATIVE_MARKDOWN=false
# Table gate: off (default) | shadow (log ruled-grid-or-crop decisions; extraction unchanged).
PAGE_ROUTER_TABLE_GATE=off
# The page probe always runs in-process through the native-pdf binding (the Python probe is gone).
# Page raster engine for renders and region crops: pdftoppm (default) | native-pdf
# (in-process and ~2.4x faster with 8 busy slots, but +670-810 MB per worker process,
# over the off-heap budget; falls back to pdftoppm/sharp).
PDF_RASTER_ENGINE=pdftoppm
# Native render lanes per document when PDF_RASTER_ENGINE=native-pdf (default min(4, cores)).
PDF_RASTER_CONCURRENCY=
# Native PDF engine: off (default) | shadow | native-pdf (primary extractor, kreuzberg fallback).
DOCSLURP_PDF_ENGINE=off
# Set to 1 in images that ship the native-pdf binding so /extractors lists it
# (worker images set it themselves with the DOCSLURP_NATIVE_PDF=1 build arg).
DOCSLURP_NATIVE_PDF_INSTALLED=
# Page OCR from the native-pdf engine: scripts (default; tesseract first, the engine
# only for scripts tesseract lacks) | prefer (engine first, guarded) | off.
NATIVE_PDF_OCR=scripts
# OCR models for the native-pdf engine (DOCSLURP_NATIVE_PDF_OCR_MODELS=1 images set it).
# Unset = no native OCR; tesseract serves every OCR assignment.
NATIVE_PDF_OCR_MODEL_DIR=
# Concurrent native-pdf OCR calls per worker process (each holds ~400-500 MB).
NATIVE_PDF_OCR_MAX_CONCURRENT=1
# CJK fallback fonts for native-pdf renders (DOCSLURP_NATIVE_PDF_CJK_FONTS=1 images set it).
NATIVE_PDF_FONTS_DIR=
WORKER_MAX_DOCUMENT_SHARDS=8
WORKER_MIN_DOCS_PER_SHARD=2
WORKER_MIN_PAGES_PER_SHARD=32
# Adjacent light stages (quarantine..normalize) share one activity; false turns all grouping off.
WORKER_GROUP_LIGHT_STAGES=true
# Read by the app (recorded in workflow input): any adjacent stages share one
# activity unless the workflow dispatches shards or page tasks for the later one
# (worker/src/temporal/stage-groups.ts); each boundary costs ~3 s. A default
# single-PDF run drops from 12 to 5 sequential activities. Default: on unless
# NODE_ENV=production. WORKER_UNGROUPED_STAGES (comma list) keeps stages alone.
# Worker-gated: the app records it only once every live worker advertises
# workflow.group-adjacent-stages, so deploy order does not matter.
WORKER_GROUP_ADJACENT_STAGES=true
WORKER_UNGROUPED_STAGES=
# Read by the app when it starts a run (recorded in workflow input): run `index`
# right after `embed`, so documents are searchable before document-summary,
# structured-extract, graph-enrich, page-index and proposition-index finish.
# The run still completes only after every stage. Default: on unless
# NODE_ENV=production; false keeps the canonical order. Worker-gated
# (workflow.index-before-enrich), like WORKER_GROUP_ADJACENT_STAGES.
WORKER_INDEX_BEFORE_ENRICH=true
# Ingest report page facts (document_page_facts): plain-text bytes and image
# count per PDF page from pdftotext + pdfimages -list (no pixel decoding), run
# beside extraction, plus the vision outcome per page. Best effort; never fails a
# document. false turns recording off. Only the first WORKER_PAGE_FACTS_MAX_PAGES
# pages of a PDF are probed (default 300; about 12 ms of CPU per dense page).
WORKER_PAGE_FACTS=true
WORKER_PAGE_FACTS_MAX_PAGES=300
# Dashboard chat answers "/status" with the ingest report (no model call). It
# also recognises questions like "how did my files process?" or "why can't it
# find page 4?"; false keeps only the slash commands. Read by the app.
CHAT_INGEST_REPORT_NATURAL=true
# Worker capability handshake (docs/releases.md#app-and-worker-skew): the app
# applies the worker-gated flags above only when every live worker on the task
# queue supports them; unknown = old behaviour. off = flags alone decide.
# Default on (off under NODE_ENV=test).
# WORKER_CAPABILITY_GATE=on
# WORKER_CAPABILITY_CACHE_MS=15000
# A registry row this fresh vouches for a live poller (ms).
# WORKER_CAPABILITY_LIVE_WINDOW_MS=90000
# With no live poller, workers seen this recently stand in (ms); IDLE_FALLBACK=none
# resolves an idle fleet to no capabilities instead.
# WORKER_CAPABILITY_RECENT_WINDOW_MS=21600000
# WORKER_CAPABILITY_IDLE_FALLBACK=recent
# Worker heartbeat into worker_capabilities (ms); WORKER_INSTANCE_ID overrides the
# WORKER_CAPABILITY_HEARTBEAT_MS=20000
# WORKER_INSTANCE_ID=
WORKER_DEFAULT_ORG_SLOTS=50
WORKER_PAGE_CHILD_BATCH_SIZE=500
# auto = one leader-elected worker runs sweeps/graph jobs; true/false force it.
WORKER_RUN_MAINTENANCE=auto
WORKER_DB_POOL_MAX=10
# Run events are buffered per worker and written with one NOTIFY hint per flush (ms; 0 = write-through).
WORKER_RUN_EVENT_FLUSH_MS=500
# Optional: activities on their own queue; workers may dial Temporal over 6PN.
TEMPORAL_ACTIVITY_TASK_QUEUE=
TEMPORAL_WORKER_ADDRESS=
# Provider back-pressure for vision/embedding calls.
AI_PROVIDER_MAX_CONCURRENCY=16
AI_PROVIDER_MAX_RETRIES=4
# Embed stage (worker). Hosted embedding batches in flight per document; windows
# and their batches share the pool, each batch still reserves fleet TPM
# (AI_RATE_LIMITS) and a provider slot. 1 = the old serial loop. Local models stay serial.
EMBED_BATCH_CONCURRENCY=4
# Minimum ms between embed progress checkpoints (usage, run counters, spend
# check); a final checkpoint is always written. 0 = one per batch.
EMBED_PROGRESS_INTERVAL_MS=500
# When the contextual-preamble document summary call starts: `inline` (default)
# after the in-run dedup check; `concurrent` before chunking/hashing (saves only
# their ~20-30 ms and pays for the call on an in-run duplicate document).
EMBED_PREAMBLE_MODE=inline
# Local (transformers.js) embedding inference runs on a bounded pool of worker
# threads, so a CPU-bound batch never blocks heartbeats, workflow tasks or
# Postgres connects (onnxruntime-node runs synchronously on its caller).
# Each thread owns one loaded model copy (~0.6 GB for bge-m3 q8) and runs one
# batch at a time; concurrent documents queue for a free thread.
# `off` runs it in-process on the event loop, as before.
# DOCSLURP_LOCAL_EMBED_THREAD=on
# Pool size (default min(2, cpus / 4), at least 1; max 16) and the ONNX Runtime
# intra-op threads per pool thread (default cpus / pool size, so the pool does not
# oversubscribe the host).
# Each thread keeps one model loaded (a request for another model replaces it), so memory
# is pool size x one model; size the pool against the host's RAM, not just its CPUs.
# DOCSLURP_LOCAL_EMBED_THREADS=
# DOCSLURP_LOCAL_EMBED_INTRA_OP_THREADS=
# Fleet-wide provider token buckets (worker). Shared through the API rate-limit
# Redis (API_RATE_LIMIT_REDIS_URL / _REST_URL+_REST_TOKEN; AI_RATE_LIMIT_REDIS_*
# override); without it, or while it is down, each process limits locally at
# AI_RATE_LIMIT_LOCAL_SHARE of each limit (set ~1/worker-machines for fleets).
# Rules: `provider:model-or-prefix*=tpm:N,rpm:N;...` (most specific wins; `none` disables).
# Unlisted provider+models are not fleet-limited. The default sits under the
# ~3M TPM OpenAI embedding ceiling measured on 2026-10-09; raise it for higher tiers.
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMITS=openai:text-embedding-*=tpm:2500000
# Each active org gets min(1, ORG_SHARE_FACTOR / active orgs) of a limit; an org
# is active if it called within the window.
AI_RATE_LIMIT_ORG_SHARE_FACTOR=1.5
AI_RATE_LIMIT_ACTIVE_ORG_WINDOW_MS=10000
# Bucket depth (ms of refill) and the longest a call waits before handing the
# wait to a Temporal retry.
AI_RATE_LIMIT_BURST_MS=2000
AI_RATE_LIMIT_MAX_WAIT_MS=120000
AI_RATE_LIMIT_LOCAL_SHARE=1
# AIMD on provider 429s: multiply the fleet rate by DECREASE (at most once per
# cooldown), recover linearly per minute; Retry-After pauses the whole fleet.
AI_RATE_LIMIT_DECREASE=0.7
AI_RATE_LIMIT_DECREASE_COOLDOWN_MS=5000
AI_RATE_LIMIT_RECOVER_PER_MINUTE=0.2
AI_RATE_LIMIT_MIN_FACTOR=0.1
AI_RATE_LIMIT_MAX_PAUSE_MS=60000
WORKER_PYTHON_POOL_SIZE=2
WORKER_SERIALIZE_PDF_CANDIDATES=false
# Paid page critique is review-only until a grounded acceptance scorer is calibrated.
DOCSLURP_CRITIQUE_ENABLED=false
DOCSLURP_CRITIQUE_MAX_COST_CENTS=0
# Conservative launch-time ceiling used to reserve budget before parallel calls.
DOCSLURP_CRITIQUE_MAX_COST_PER_PAGE_CENTS=1
# Hard RSS ceiling per worker subprocess tree. Leave blank to auto-derive from the container cgroup limit.
WORKER_COMMAND_MAX_RSS_MB=
# Caps the worker Node.js heap before native/process overhead. Leave blank to auto-derive from the container cgroup limit.
WORKER_NODE_MAX_OLD_SPACE_MB=
# ClamAV runtime health. Production should run with managed `clamd`, startup signature refresh,
# and fail-closed signature freshness checks.
DOCSLURP_CLAMAV_ENABLED=true
DOCSLURP_CLAMAV_MANAGE_DAEMON=
DOCSLURP_CLAMAV_REQUIRE_DAEMON=
DOCSLURP_CLAMAV_UPDATE_ON_STARTUP=true
DOCSLURP_CLAMAV_FAIL_OPEN_ON_STALE_DB=
DOCSLURP_CLAMAV_MAX_DB_AGE_HOURS=24
DOCSLURP_CLAMAV_DB_DIR=/var/lib/clamav
DOCSLURP_CLAMAV_CLAMD_CONF=/etc/clamav/clamd.conf
DOCSLURP_CLAMAV_FRESHCLAM_CONF=/etc/clamav/freshclam.conf
WORKER_BUDGET_SWEEP_INTERVAL=1h
WORKER_RETENTION_SWEEP_INTERVAL=6h
WORKER_RETENTION_SWEEP_BATCH_SIZE=25
# Workspace knowledge-graph rebuild jobs: poll interval (0 disables) and documents extracted at once.
WORKER_GRAPH_JOB_POLL_INTERVAL=5s
WORKER_GRAPH_JOB_CONCURRENCY=4
WORKER_INTEGRITY_SWEEP_MAX_KEYS=20000
WORKER_INTEGRITY_SWEEP_PREFIX=
DOCSLURP_QUEUED_DOCUMENTS_PER_WORKER_MACHINE=1
DOCSLURP_QUEUED_PAGES_PER_WORKER_MACHINE=25
DOCSLURP_WORKER_MAX_AUTOSCALE_MACHINES=12

# -----------------------------------------------------------------------------
# Run recovery, retention, quarantine, and metrics
# -----------------------------------------------------------------------------
# Run-start recovery (app): queued runs whose Temporal start was deferred or
# lost are retried at boot, every RUN_START_RECOVERY_INTERVAL_MS (0 = boot and
# reconnect kicks only) and on each Temporal reconnect. Only published, complete
# Run manifests are eligible. Abandoned creation is cleaned after its renewable
# five-minute lease expires; failed starts back off from RUN_START_RETRY_BASE_MS
# to RUN_START_RETRY_MAX_MS.
RUN_START_RECOVERY_INTERVAL_MS=5000
RUN_START_RECOVERY_BATCH_SIZE=25
RUN_START_RETRY_BASE_MS=2000
RUN_START_RETRY_MAX_MS=60000
# Boot warm-up / background reconnect deadline; request paths still give up after 2 s.
TEMPORAL_BACKGROUND_CONNECT_TIMEOUT_MS=10000
# The stale-queued sweep is now only a backstop for closed workflows; it also
# runs at boot, and once a minute from run-start recovery when maintenance is off.
STALE_QUEUED_RUN_SWEEP_LIMIT=8
STALE_QUEUED_RUN_COLD_START_GRACE_MS=600000
STUCK_QUEUED_RUN_FAIL_AFTER_MS=86400000
# Quarantine defaults to fail-closed in production (`NODE_ENV=production`).
# Set this to `true` only for local/dev workflows where you intentionally want to keep ingest moving without ClamAV.
QUARANTINE_FAIL_OPEN_ON_TOOL_MISSING=
API_KEY_USAGE_RETENTION_DAYS=30
PERF_LOG_RETENTION_DAYS=90
METRICS_SECRET=

# -----------------------------------------------------------------------------
# Alerting (docs/observability.md#alerting)
# -----------------------------------------------------------------------------
# One leader-elected app instance evaluates queue age, stale leases, worker
# pollers/crash loops, migrations, Temporal and DB reachability; every instance
# evaluates its own 5xx rate. Notifications are always logged as `[alert]` lines;
ALERT_WEBHOOK_URL=
# slack = {"text": ...} (Slack, Discord /slack, Mattermost); json = structured payload.
ALERT_WEBHOOK_FORMAT=slack
ALERT_ENVIRONMENT=
# 0 disables the evaluator.
ALERT_EVALUATION_INTERVAL_MS=60000
# Consecutive failing evaluations before notifying; reminder cadence while firing.
ALERT_PENDING_EVALUATIONS=2
ALERT_REPEAT_INTERVAL_MS=14400000
ALERT_QUEUED_RUN_AGE_SECONDS=900
ALERT_STALE_LEASES=1
ALERT_POLLER_STALE_MS=180000
# Alerts also go to Telegram when TELEGRAM_BOT_TOKEN (below) and a chat are set:
# ALERT_TELEGRAM_CHAT_ID, else TELEGRAM_CHAT_ID. off disables.
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_TELEGRAM=on
# Worker floor fallback (docs/scaling-1000-workers.md#autoscaler-failure-modes):
# the leader starts one stopped worker machine when runs wait with no live pollers.
# Unset = alert only.
# WORKER_FLOOR_COOLDOWN_MS=300000
ALERT_WORKER_RESTARTS_PER_MACHINE=3
ALERT_WORKER_RESTART_WINDOW_MS=900000
ALERT_HTTP_5XX_RATE=0.05
ALERT_HTTP_5XX_MIN_REQUESTS=20
ALERT_HTTP_5XX_WINDOW_MS=300000

# -----------------------------------------------------------------------------
# Backups and restore drills (operator scripts only; docs/disaster-recovery.md)
# -----------------------------------------------------------------------------
# Separate bucket and access key from STORAGE_URI. Used by
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
# Scratch Postgres for restore drills; never a production server.
# RESTORE_DRILL_TARGET_URL=

# -----------------------------------------------------------------------------
# API rate limiting
# -----------------------------------------------------------------------------
# per-process in-memory sliding windows and logs a production/self-hosted warning.
# Local Docker Compose starts Redis on redis://redis:6379, and app/API shells
# rewrite that host to localhost automatically outside containers.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_DEFAULT_PROFILE=free
API_RATE_LIMIT_KEY_PREFIX=api
API_RATE_LIMIT_REDIS_URL=redis://redis:6379
# running a dedicated Redis VM. If both REST vars are set, they win over REDIS_URL.
API_RATE_LIMIT_REDIS_REST_URL=
API_RATE_LIMIT_REDIS_REST_TOKEN=
# Suspicious-traffic guards per client IP (set any *_MAX to 0 to disable):
# a burst over API_RATE_LIMIT_IP_BURST_MAX requests per window, or too many
# invalid API keys, blocks the IP for the penalty duration.
# API_RATE_LIMIT_IP_BURST_MAX=200
# API_RATE_LIMIT_IP_BURST_WINDOW_MS=10000
# API_RATE_LIMIT_IP_BURST_PENALTY_MS=60000
# API_RATE_LIMIT_AUTH_FAILURE_MAX=20
# API_RATE_LIMIT_AUTH_FAILURE_WINDOW_MS=300000
# API_RATE_LIMIT_AUTH_FAILURE_PENALTY_MS=900000
# counting this many proxy hops from the right (left entries are client-supplied).
# Ignored once TRUSTED_PROXIES is set.
# API_TRUSTED_PROXY_HOPS=1
# Trusted reverse proxies in front of the app: the `cloudflare` keyword (Cloudflare's pinned
# ranges) and/or CIDRs, comma separated. Forwarded client headers are read only when the
# set: CF-Connecting-IP for Cloudflare peers, an X-Forwarded-For right-most-untrusted walk for
# CIDR peers. Empty (default) means no proxy: the peer address is used as before.
# TRUSTED_PROXIES=cloudflare
# TRUSTED_PROXIES=cloudflare,10.0.0.0/8
# Hardening, default off: answer 403 to requests whose immediate peer is not a trusted proxy
# REQUIRE_TRUSTED_PROXY=false
# Optional per-category overrides (the legacy global API_RATE_LIMIT_MAX_REQUESTS
# only applies to a category with no policy), examples:
# API_RATE_LIMIT_SEARCH_MAX=60
# API_RATE_LIMIT_FREE_UPLOAD_MAX=20
# API_RATE_LIMIT_PAID_CHAT_AI_MAX=120

# -----------------------------------------------------------------------------
# Local seed users and Python runtime
# -----------------------------------------------------------------------------
# Default Better Auth-backed development seed fixtures (`pnpm exec tsx server/db/seed.ts`)
# Automatically synced during app/API startup only when NODE_ENV=development.
# Quick-login buttons and the shortcut endpoint remain development-only.
# SEED_ADMIN_EMAIL=<local-seed-email>
# Comma-separated, case-insensitive verified account emails to auto-admit as admins.
# Existing org/workspace memberships are promoted; owner roles are preserved.
ADMIN_EMAILS=
# Email registration requires a working sender and six-digit email verification.
# Without both settings, existing verified users can sign in; registration is disabled.
RESEND_API_KEY=
EMAIL_FROM=
# SEED_MEMBER_EMAIL=<local-seed-email>
PYTHON_VENV=.venv
# Install a missing optional Python package (declared in worker/requirements*.txt,
# pinned to worker/requirements.lock.txt) into the venv on first use and retry.
# Also provisions pandoc from pypandoc-binary. Set false on air-gapped hosts.
DOCSLURP_PYTHON_LAZY_INSTALL=true
# Prefer pinned Linux x86_64 worker lockfiles automatically in containers/CI.
# Set to `locked` to require them, or `loose` to force the unlocked manifests.
DOCSLURP_WORKER_REQUIREMENTS_MODE=auto

# -----------------------------------------------------------------------------
# Authentication, OAuth, and encryption
# -----------------------------------------------------------------------------
# Create a random 32-byte hex string for production use: `openssl rand -hex 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Optional comma-separated allowlist of extra origins Better Auth should trust.
BETTER_AUTH_TRUSTED_ORIGINS=
# Only enable behind a proxy you control (e.g. Cloudflare / your ingress).
BETTER_AUTH_TRUST_PROXY_HEADERS=false
# report-only (default): enforce object-src/base-uri/frame-ancestors and report
# the full img/connect/script/frame allowlist; enforce: enforce all of it; off: none.
APP_CSP_MODE=report-only
# OAuth token encryption key for oauth_accounts persistence (use strong random value in non-dev)
OAUTH_TOKEN_ENCRYPTION_KEY=
# GitHub OAuth (https://github.com/settings/developers)
# GitHub OAuth Callback path: /api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------
# Plans, credits and metering: docs/pricing-and-credits.md. 1 credit = 1 cent.
# Stripe (optional). Without STRIPE_SECRET_KEY, checkout/portal/top-up routes
# return 503 billing_not_configured; the billing overview and credit gating
# still work. Use a restricted key in production.
STRIPE_SECRET_KEY=
# Signing secret for POST /webhooks/stripe (`stripe listen --forward-to localhost:4321/webhooks/stripe`)
STRIPE_WEBHOOK_SECRET=
# Publishable key for the Payment Element (saved cards)
PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Tax on Checkout (needs a head-office address in the Stripe dashboard).
# Set to false for test accounts without Stripe Tax configured.
STRIPE_AUTOMATIC_TAX=true
# Plan Products/Prices are synced from packages/shared/src/billing.ts by:
# Metering is ENFORCED whenever STRIPE_SECRET_KEY is set: worker CPU/RAM/GPU is
# billed at rate-card list prices and the daily storage meter runs, regardless
# of the two flags below (workers learn this via the billing_runtime table).
# Without Stripe, true turns each meter on for testing.
DOCSLURP_BILL_COMPUTE=false
DOCSLURP_BILL_STORAGE=false
# Runs are always blocked once included + prepaid credits reach 0. Set a positive
# number of credits (cents) to require a larger floor before a run starts.
MIN_CREDIT_BALANCE_CENTS=0
# Connector credential encryption key (32-byte hex or strong passphrase) — required
# Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=
# Workspace secret encryption key (32-byte hex) — required for workspace_secrets at-rest encryption
# Generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=
# Optional: dedicated root for file proxy URL tokens (/v1/files). Rotating it revokes
# every outstanding file URL and nothing else. Falls back to SECRETS_ENCRYPTION_KEY,
# then BETTER_AUTH_SECRET.
FILE_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Temporal workflow orchestration
# -----------------------------------------------------------------------------
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=docslurp
TEMPORAL_TASK_QUEUE=docslurp-pipeline
TEMPORAL_TLS_ENABLED=false
TEMPORAL_TLS_SERVER_NAME=
TEMPORAL_TLS_CA_CERT_PATH=
TEMPORAL_TLS_CA_CERT_PEM=
TEMPORAL_TLS_CLIENT_CERT_PATH=
TEMPORAL_TLS_CLIENT_CERT_PEM=
TEMPORAL_TLS_CLIENT_KEY_PATH=
TEMPORAL_TLS_CLIENT_KEY_PEM=
TEMPORAL_CLIENT_IDENTITY=docslurp-app
TEMPORAL_WORKER_IDENTITY=docslurp-worker
TEMPORAL_WORKER_BUILD_ID=
# off (default): Build ID tags tasks only. deployment: Worker Deployment Versioning; needs a
# set-current-version step per deploy (docs/temporal-workflow-changes.md) or workers get no tasks.
TEMPORAL_WORKER_VERSIONING=off
# Access the Temporal Web UI at this port (default: 8233)
TEMPORAL_UI_PORT=8233
